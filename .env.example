# Copier ce fichier en .env (à la racine, à côté de docker-compose.yml)
# puis renseigner les vraies valeurs. Le .env n'est PAS versionné (secrets).

# Base de données MySQL
DB_NAME=v_tech
DB_USER=v_tech
DB_PASSWORD=v_tech_pwd
MYSQL_ROOT_PASSWORD=change_me_root_password

# Groq (chatbot + scoring qualitatif). Une clé valide est requise pour le chat
# et l'analyse qualitative. Les deux services utilisent cette même clé.
GROQ_API_KEY=gsk_remplace_par_ta_cle
GROQ_MODEL=openai/gpt-oss-120b

# Authentification (JWT). Mettre une valeur secrète longue et aléatoire en prod.
JWT_SECRET=change_me_avec_une_chaine_aleatoire_longue
JWT_EXPIRES_IN=12h

# Comptes initiaux créés au 1er démarrage (modifiable). Le compte admin système
# est l'identifiant principal ; à CHANGER après la première connexion.
KIAMA_ADMIN_EMAIL=admin@kiama.local
KIAMA_ADMIN_PASSWORD=Admin#2026
KIAMA_EXPLOITATION_PASSWORD=Exploit#2026
KIAMA_USER_PASSWORD=User#2026

# (Optionnel) Clé partagée pour les appels service-à-service (extracteur, scripts).
# Le frontend, lui, utilise désormais l'authentification JWT (login).
# KIAMA_API_KEY=

# Note : l'URL de l'API du frontend est gérée automatiquement par docker-compose
# (VITE_API_URL=/api, relayé par le nginx du conteneur frontend vers le backend).
# Rien à configurer ici pour un déploiement Docker.

# ── SSO Microsoft Entra ID (OIDC) — voir SSO_MICROSOFT.md ─────────────────────
# Laisser SSO_ENABLED=false tant que l'inscription d'app Entra n'est pas faite :
# l'application reste alors en connexion e-mail + mot de passe (aucun impact).
SSO_ENABLED=false
ENTRA_TENANT_ID=            # ID de l'annuaire (locataire) KIAMA
ENTRA_CLIENT_ID=            # ID d'application (client) de l'inscription Entra
ENTRA_CLIENT_SECRET=        # uniquement pour le flux serveur (auth code)
SSO_ALLOWED_DOMAIN=kiama.cm
